NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/varsha_homemade
DATABASE_SSL=false

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Set to 1 when running behind a reverse proxy / load balancer
TRUST_PROXY=0

# Auth rate limit: max requests per window (ms) per IP
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Cart
CART_ANONYMOUS_TTL_DAYS=30
CART_MAX_ITEM_QUANTITY=99
CART_MAX_DISTINCT_ITEMS=50

# Product CMS client (required, no default): 'mock' (built-in sample catalog, dev/test only) or 'http'
PRODUCT_SERVICE_PROVIDER=http
PRODUCT_SERVICE_URL=https://varsha-homemade-cms.onrender.com
PRODUCT_SERVICE_TIMEOUT_MS=8000

# Swagger UI at /api-docs (always off in production unless true)
ENABLE_DOCS=true
