# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Set to 1 when running behind a reverse proxy / load balancer
TRUST_PROXY=0

# Auth rate limit: max requests per window (ms) per IP
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Swagger UI at /api-docs (always off in production unless true)
ENABLE_DOCS=true
CORS_ALLOWED_ORIGINS=http://localhost:5174,https://varsha-homemade.onrender.com

PRODUCT_SERVICE_PROVIDER=http
PRODUCT_SERVICE_URL=https://varsha-homemade-cms.onrender.com
PRODUCT_SERVICE_TIMEOUT_MS=8000

# Guest checkout session lifetime in hours
GUEST_CHECKOUT_SESSION_TTL_HOURS=24
# How often expired guest sessions are purged (minutes, 0 = disabled)
GUEST_CHECKOUT_CLEANUP_INTERVAL_MINUTES=60

RAZORPAY_KEY_ID=rzp_test_Twy3rYl2vOqcOZ
RAZORPAY_KEY_SECRET=QNWKR8qKAr7zivSVhB7zcyUE
RAZORPAY_WEBHOOK_SECRET=uh36cbyg.Qs2:S!
# Checkout pricing (server-side; amounts from clients are never trusted)
# Razorpay credentials: RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET (set real values only in your untracked .env)
CHECKOUT_TAX_RATE_PERCENT=0
CHECKOUT_SHIPPING_FLAT_FEE=0
# Shipping is free once the order reaches this amount (0 = no waiver)
CHECKOUT_FREE_SHIPPING_THRESHOLD=0
# How long an unpaid order stays payable
ORDER_PAYMENT_WINDOW_MINUTES=1440
CHECKOUT_RATE_LIMIT_MAX=60

# Shiprocket (serviceability check only). Set real credentials only in your untracked .env
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_TIMEOUT_MS=8000
# Box/filler weight added to every package, in grams
SHIPPING_PACKAGING_WEIGHT_GRAMS=100
